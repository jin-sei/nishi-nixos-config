* {
    font:   "M PLUS 1 Code 14";

    bg0:     #000000;
    bg1:     #404040;
    fg0:     #eeffff;

    accent-color:     #0C0C0C;
    urgent-color:     #ffcb6b;

    border-color:     #595959AA;
    
    prompt-color:     #595959;

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    location:   center;
    
    width:      600;

    background-color:   @bg0;
    
    border:         1px;
    border-color:   @border-color;
    
    border-radius:  13px;
    
    padding:        10px 10px 0px 10px;
}

inputbar {
    spacing:    8px;
    padding:    8px;

    background-color:   @bg0;
}

prompt, entry, element-icon, element-text {
    vertical-align: 0.5;
}

prompt {
    text-color: @prompt-color;
}

textbox {
    padding:            8px;
    
    background-color:   @bg0;
}

listview {
    padding:    8px 0;
    lines:      5;
    columns:    1;

    fixed-height: 0;
}

element {
    padding:    14px 8px;
    spacing:    8px;
    
    border-radius: 7px;
}

element normal normal {
    text-color: @fg0;
}

element normal urgent {
    text-color: @urgent-color;
}

element normal active {
    text-color: @accent-color;
}

element alternate active {
    text-color: @accent-color;
}

element selected {
    text-color: @fg0;
}

element selected normal, element selected active {
    background-color:   @accent-color;
}

element selected urgent {
    background-color:   @urgent-color;
}

element-icon {
    size:   0.8em;
}

element-text {
    text-color: inherit;
    highlight: none;
}
